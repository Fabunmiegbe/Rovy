# Copy to .env and fill in before deploying. Never commit the real .env file.

# Deployer wallet private key (must hold ETH on Robinhood Chain mainnet to pay gas)
PRIVATE_KEY=

# Optional: override public RPCs with a dedicated provider (Alchemy/QuickNode/Chainstack)
# for production use — the public endpoints are rate-limited.
ROBINHOOD_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com

# Where unrevealed placeholder metadata lives before mint opens
UNREVEALED_URI=https://rovyn.xyz/metadata/unrevealed.json

# Frontend: deployed contract address, filled in after deploy.js runs
NEXT_PUBLIC_ROVYN_CONTRACT_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=4663
